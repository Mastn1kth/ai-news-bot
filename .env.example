TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin chat ID for pipeline alerts (can be same as TELEGRAM_CHAT_ID or a personal chat).
# Leave empty to disable alerts.
ADMIN_CHAT_ID=
MIN_SCORE=65
MAX_POSTS_PER_RUN=3
DRY_RUN=true
REQUEST_TIMEOUT=15
FETCH_RETRIES=3
MAX_ITEMS_PER_SOURCE=8
PUBLISH_DELAY_SECONDS=5
USE_LLM=false
USE_TELEGRAM_FETCHER=false

# Optional LLM mode. Used only when USE_LLM=true.
# Providers: ollama, openai-compatible
LLM_PROVIDER=ollama
LLM_API_BASE=http://localhost:11434/api/generate
LLM_API_KEY=
LLM_MODEL=llama3.1
LLM_TIMEOUT=45

# Backward-compatible alias. If LLM_MODEL is empty, OLLAMA_MODEL is used.
OLLAMA_MODEL=llama3.1

# Optional Telethon mode. Used only when USE_TELEGRAM_FETCHER=true.
TELETHON_API_ID=
TELETHON_API_HASH=
TELETHON_SESSION=ai_news_bot
